<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only manifest: E2E broadcast test driver exists ONLY in debug builds.
     Release builds physically exclude the receiver (standard ① hardening). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug-only: E2ETestReceiver posts notifications via `cmd notification
         post` — lint's NotificationPermission applies to the merged debug
         variant; release builds physically exclude the receiver. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <receiver
            android:name="io.github.deserthouse.opticon.util.E2ETestReceiver"
            android:exported="true" />
    </application>
</manifest>
